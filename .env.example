# Supabase PostgreSQL Transaction Pooler (application runtime)
DATABASE_URL=

# Supabase Session Pooler or direct connection (Prisma migrations)
DIRECT_URL=

# Optional. OnclickMedia public/free API works without a key.
ONCLICKMEDIA_API_KEY=

# Protects GET /api/cron/sync
CRON_SECRET=

# Production default is false
ENABLE_DEBUG_PAGE=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
